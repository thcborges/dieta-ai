# ==============================================================================
# MacroMetrics Pro - Error Healer & Self-Healing Worker (.env.example)
# ==============================================================================

# Telegram Bot (notificações estruturadas e comando /deploy-dev)
TELEGRAM_BOT_TOKEN="<SEU_BOT_TOKEN_DO_BOTFATHER>"
TELEGRAM_CHAT_ID="<SEU_CHAT_ID>"

# Google Cloud Pub/Sub (Ambiente Dev us-central1)
GCP_PROJECT_ID="thcborges-dieta-ai-dev"
PUBSUB_SUBSCRIPTION="dieta-ai-errors-dev-sub"

# Auto-Cura via Antigravity CLI (true para acionar correção automática)
AUTO_HEAL_ENABLED="true"

# GitHub Token (opcional, necessário se for usar o comando /deploy-dev no Telegram)
GITHUB_TOKEN="<SEU_GITHUB_PAT>"
