{
  "name": "dieta-ai-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "MacroMetrics Pro - Analytical diet planning & reverse engineering engine",
  "scripts": {
    "dev": "pnpm --filter @dieta-ai/web dev",
    "dev:api": "pnpm --filter @dieta-ai/api dev",
    "preview": "pnpm --filter @dieta-ai/web preview",
    "test": "pnpm --workspace-concurrency=1 -r test",
    "test:coverage": "pnpm --workspace-concurrency=1 -r test:coverage",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "@vitest/coverage-v8": "^3.0.7"
  },
  "packageManager": "pnpm@12.11.2"
}
