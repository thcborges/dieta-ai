rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // MacroMetrics Pro: Zero-Trust Security Policy (Browser Isolation)
    // O banco de dados Firestore é exclusivo do backend autenticado (Cloud Run / Fastify) via Admin SDK / service account.
    // Qualquer tentativa de leitura ou escrita direta por clientes Web/Mobile desautorizados é sumariamente bloqueada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
